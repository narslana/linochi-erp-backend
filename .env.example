# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://linochi:dev@localhost:5432/linochi_erp?sslmode=disable
LOG_LEVEL=debug
SHUTDOWN_DELAY=0s
# Traces to Alloy: kubectl port-forward -n alloy svc/alloy 4318, then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Connection pool. 5 per pod is the budget (docs/DECISIONS.md); the cluster has 100 for all services.
DB_MAX_CONNS=5
