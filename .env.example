# Copy to .env for local development. Never commit .env.
#
# The app connects as the restricted role linochi_erp_app. Migrations run as the
# owner, linochi_erp_owner, with their own URL (`api migrate` uses only that one).
DATABASE_URL=postgres://linochi_erp_app:dev@localhost:5432/linochi_erp?sslmode=disable
MIGRATE_DATABASE_URL=postgres://linochi_erp_owner:dev@localhost:5432/linochi_erp?sslmode=disable
LOG_LEVEL=debug
SHUTDOWN_DELAY=0s
# Traces to Alloy: kubectl port-forward -n alloy svc/alloy 4318, then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Connection pool. 5 per pod is the budget (docs/DECISIONS.md); the cluster has 100 for all services.
DB_MAX_CONNS=5
# Login. Locally `make dev-oidc` runs a provider that logs everybody in as one
# fixed user (cmd/devoidc, loopback only), and these are what it serves. In the
# cluster they point at Authelia and the secret is a Sealed Secret.
OIDC_ISSUER=http://127.0.0.1:9096
OIDC_CLIENT_ID=linochi-erp
OIDC_CLIENT_SECRET=dev-only-client-secret
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
# The Authelia groups that give the admin role. This is the default.
# AUTH_ADMIN_GROUPS=admins,linochi_erp_users
